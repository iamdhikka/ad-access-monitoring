# Salin menjadi .env lalu ganti semua password.
# Password AD wajib kompleks: minimal 8 karakter, ada huruf besar, kecil, angka, dan simbol.

# Jangan ubah AD_REALM/AD_DOMAIN kecuali Anda juga mengubah alias jaringan di docker-compose.yml
AD_REALM=CORP.LAB
AD_DOMAIN=CORP

AD_ADMIN_PASSWORD=Ganti!Admin-2026
AD_MONITOR_PASSWORD=Ganti!Monitor-2026

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GantiPasswordGrafana123

# Jumlah user awal dan jeda antar-aktivitas simulasi (detik)
SEED_USERS=300
SIM_INTERVAL_SECONDS=20
