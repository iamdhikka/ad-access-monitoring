          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Group",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "domain": true
            },
            "indexByName": {
              "group": 0,
              "member": 1,
              "department": 2
            },
            "renameByName": {
              "group": "Group",
              "member": "Akun",
              "department": "Departemen"
            }
          }
        }
      ]
    },
